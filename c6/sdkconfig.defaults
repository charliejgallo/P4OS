# Co-processor for an MCU host, Wi-Fi and BLE (HCI over the transport)
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y

# 4 MB flash, two OTA slots: the P4 updates it over SDIO
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CACHE_MALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# P4OS: the 802.15.4 radio lent to the P4 over esp_hosted's peer_data channel
# (main/radio154.c, docs/plan/ZIGBEE.md), sharing the antenna with the Wi-Fi
# and the BLE by Espressif's software coexistence
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
CONFIG_IEEE802154_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# P4OS: Espressif's Zigbee stack (main/zigbee_test.c) is off here, in the
# image releases carry; sdkconfig.zigbee turns it on for a measuring build
# (docs/plan/ZIGBEE.md): it does not fit the factory slot of 1.5 MB without
# -Os, which the Wi-Fi's data path is better without.
CONFIG_ZB_ENABLED=n

# P4OS: main/slots.c rewrites the partition table at 0x8000 (the factory
# slots of 1.5 MB grown to 1.94 MB), only when the P4 asks and after its
# checks; the IDF refuses a write there unless this allows it.
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# P4OS: the C6 as a radio co-processor for a Zigbee or Thread stack on the P4
# (main/rcp.c), on request: the IDF's OpenThread RCP, its spinel over
# peer_data (its UART is set up with no pins)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO=y
CONFIG_OPENTHREAD_RCP_UART=y
CONFIG_OPENTHREAD_DIAG=n
CONFIG_OPENTHREAD_COMMISSIONER=n
CONFIG_OPENTHREAD_JOINER=n
CONFIG_OPENTHREAD_BORDER_ROUTER=n
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_OPENTHREAD_TASK_SIZE=3072
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
